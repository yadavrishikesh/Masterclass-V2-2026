      },
      "source": [
        "## Question 2: Self-Attention Mechanism\n",
        "\n",
        "### (a) Introduce a simple sentence\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "9-AavyaMXbjW",
        "outputId": "5a80566e-dba5-4308-9d92-370dc29c544d"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Sentence: ['the', 'cat', 'sat', 'on', 'the', 'mat']\n"
          ]
        }
      ],
      "source": [
        "sentence = \"The cat sat on the mat\".lower().split()\n",
        "print('Sentence:', sentence)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "7lzGmtP7XbjW"
      },
      "source": [
        "### (b) Convert words into embeddings\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "Alg5tYGoXbjX",
        "outputId": "262e1cb2-9a83-4cac-8bf9-db0c32035eec"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Embeddings matrix shape: torch.Size([6, 4])\n"
          ]
        }
      ],
      "source": [
        "# To keep it extremely simple, let's create random embeddings for each word.\n",
        "torch.manual_seed(42)\n",
        "# Let's say our embedding dimension is 4\n",
        "embeddings = torch.randn(len(sentence), 4)\n",
        "print('Embeddings matrix shape:', embeddings.shape)\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "MiMyY7QHXbjX"
      },
      "source": [
        "### (c) Compute simplified Query, Key, and Value vectors\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "id": "EI3PB7rJXbjY"
      },
      "outputs": [],
      "source": [
        "# We multiply our embeddings by weight matrices to get Q, K, V.\n",
        "# We'll just define dummy weight matrices.\n",
        "W_q = torch.randn(4, 4)\n",
        "W_k = torch.randn(4, 4)\n",
        "W_v = torch.randn(4, 4)\n",
        "\n",
        "Q = embeddings @ W_q\n",
        "K = embeddings @ W_k\n",
        "V = embeddings @ W_v\n"
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {
        "id": "_SCK3OH7XbjY"
      },
      "source": [
        "### (d) Calculate attention scores\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "DpzHgpWMXbjY",
        "outputId": "2d04a877-baea-4206-96d3-6c568a658263"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Attention Weights:\n",
            " tensor([[1.0000e+00, 4.2350e-06, 9.1798e-08, 4.0314e-09, 2.5254e-07, 1.1952e-08],\n",
            "        [1.0000e+00, 2.8624e-07, 1.3706e-10, 7.8352e-13, 1.5604e-10, 1.5715e-12],\n",
            "        [4.3968e-01, 3.1964e-02, 8.8966e-02, 3.4444e-01, 9.0971e-03, 8.5855e-02],\n",
            "        [5.3858e-10, 3.7228e-07, 9.2948e-04, 9.7392e-01, 6.2371e-06, 2.5142e-02],\n",
            "        [9.8231e-01, 1.6783e-02, 2.4747e-05, 1.1228e-07, 8.7798e-04, 1.4411e-06],\n",
            "        [1.0568e-05, 1.0485e-03, 3.7289e-02, 7.6310e-01, 6.2874e-03, 1.9226e-01]])\n"
          ]
        }
      ],
      "source": [
        "# Dot product of queries and keys\n",
        "scores = Q @ K.T\n",
        "\n",
        "# Scale by sqrt of embedding dimension and apply softmax across columns\n",
        "attention_weights = torch.softmax(scores / np.sqrt(4), dim=-1)\n",
        "print('Attention Weights:\\n', attention_weights)\n"
      ]
    },
