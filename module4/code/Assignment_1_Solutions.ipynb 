      "source": [
        "### (d) Create a decoder that reconstructs the image\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "416IOdNKXbjR",
        "outputId": "6384205e-64d1-4596-eff9-4200f88e2238"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Reconstructed shape: torch.Size([1, 1, 28, 28])\n"
          ]
        }
      ],
      "source": [
        "class SimpleDecoder(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.up = nn.Upsample(scale_factor=2, mode='nearest')\n",
        "        self.conv = nn.Conv2d(16, 1, 3, padding=1)\n",
        "    def forward(self, x):\n",
        "        return torch.sigmoid(self.conv(self.up(x)))\n",
        "\n",
        "decoder = SimpleDecoder()\n",
        "reconstructed = decoder(latent)\n",
        "print('Reconstructed shape:', reconstructed.shape)\n"
      ]
    },
    {
