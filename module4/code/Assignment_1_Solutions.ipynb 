        "### (b) Create a simple encoder that progressively compresses information\n"
      ]
    },
    {
      "cell_type": "code",
      "execution_count": null,
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "d3R4MTxiXbjP",
        "outputId": "f02135c5-9328-45ed-fdb2-10d55e9d9ac8"
      },
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Original shape: torch.Size([1, 1, 28, 28])\n",
            "Latent shape: torch.Size([1, 16, 14, 14])\n"
          ]
        }
      ],
      "source": [
        "class SimpleEncoder(nn.Module):\n",
        "    def __init__(self):\n",
        "        super().__init__()\n",
        "        self.conv = nn.Conv2d(1, 16, 3, padding=1)\n",
        "        self.pool = nn.MaxPool2d(2, 2)\n",
        "\n",
        "    def forward(self, x):\n",
        "        return self.pool(torch.relu(self.conv(x)))\n",
        "\n",
        "\n",
        "encoder = SimpleEncoder()\n",
        "# Add batch dimension: (1, 1, 28, 28)\n",
        "latent = encoder(img.unsqueeze(0))\n",
        "print('Original shape:', img.unsqueeze(0).shape)\n",
        "print('Latent shape:', latent.shape)\n"
      ]
    },
